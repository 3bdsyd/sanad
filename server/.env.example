# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
ADMIN_TOKEN=replace-with-unique-secret-of-at-least-32-characters
DATABASE_PATH=/data/fursa.sqlite3
API_DOMAIN=api.example.com
# Exact browser origins, comma separated; mobile clients do not send Origin.
ALLOWED_ORIGINS=https://jobs.example.com
# Leave empty unless behind a known reverse proxy. Never trust 0.0.0.0/0.
TRUSTED_PROXIES=
