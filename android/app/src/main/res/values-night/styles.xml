<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The night resource palette also covers the frame before Flutter draws. -->
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/sanad_canvas</item>
        <item name="android:navigationBarColor">@color/sanad_canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/sanad_canvas</item>
        <item name="android:statusBarColor">@color/sanad_canvas</item>
        <item name="android:navigationBarColor">@color/sanad_canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
