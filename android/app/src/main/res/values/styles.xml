<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Match Flutter's first frame, including when the system uses dark mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/sanad_canvas</item>
        <item name="android:navigationBarColor">@color/sanad_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/sanad_canvas</item>
        <item name="android:statusBarColor">@color/sanad_canvas</item>
        <item name="android:navigationBarColor">@color/sanad_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
